# Klangregler-Simulatoren – Apache 2.4
# Benötigt im VirtualHost/Verzeichnis: AllowOverride FileInfo Indexes Options (oder AllowOverride All)

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
AddCharset utf-8 .html .js .webmanifest .txt

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType text/javascript .js
    AddType font/woff2 .woff2
</IfModule>

# Kompression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/javascript application/manifest+json
</IfModule>

# Zwischenspeichern im Browser
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/manifest+json "access plus 1 day"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/png "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    # HTML und Service Worker immer frisch prüfen, damit Änderungen sofort ankommen
    <FilesMatch "\.(html|js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <Files "sw.js">
        Header set Service-Worker-Allowed "/"
    </Files>
    # Sicherheit: nur Inhalte von diesem Server, keine Einbettung in fremde Seiten
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
