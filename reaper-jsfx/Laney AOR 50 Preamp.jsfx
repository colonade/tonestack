O_DSCP = 2140;
O_PAR = 2141;
// feste Bauteile (Plan DRG 1054)
r1 = 68000; r5 = 100000; r6 = 1000; vr101 = 100000; vr102 = 1000000; ronvt = 200; rts = 250; mu = 100; rp0 = 62500; ia0 = 0.0012; cgk = 0.0000000000016; cga = 0.0000000000017;
ck = 0.000000022; c4 = 0.000000022; c5 = 0.000000000470; c6 = 0.000000220; r18 = 33000; c7 = 0.000000000470; c8 = 0.000000022; c11 = 0.000000022; c10 = 0.000000022;
vr105 = 220000; vr106 = 1000000; vr107 = 22000; c9 = 0.000000010; c12 = 0.000000022; c13 = 0.0000022; c15 = 0.000000015; c16 = 0.000000220; c106 = 0.000000001; vr104 = 100000; vr103 = 100000;
c201 = 0.0000022; c202 = 0.0000022; c18 = 0.000000022; c21 = 0.000000022;
N_H1 = 35986.334852078886; N_H2 = 920.5260111823894; N_L1 = 29.12973364705375; N_L2 = 37.52073127705745;
// Speicher: Netzliste, Arbeitsbereich, Instanzen, Verlauf
EA = 0; EB = EA + 51; CA = EB + 51; CB = CA + 31; TG = CB + 31; TP = TG + 6; TK = TP + 6;
RV = TK + 6; CV = RV + 51; TGM = CV + 31;
AM = TGM + 6; PIV = AM + 1681; RHS = PIV + 41;
I0 = 65536; I1 = I0 + INST; HB = I1 + INST; HL = 262144;
