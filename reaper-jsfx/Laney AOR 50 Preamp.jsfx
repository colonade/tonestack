TG[5] = 28; TP[5] = 30; TK[5] = 31;

function blendR(ron, roff, x, rref) local(yon, yoff, y) (
  x >= 1 ? ron : x <= 0 ? roff : (yon = rref / (ron + rref); yoff = rref / (roff + rref); y = yoff + x * (yon - yoff); rref * (1 / y - 1));
);
function rp_of(ia) ( rp0 * pow(ia0 / ia, 1/3); );
function taper(x, tpy) local(mid, s, bb) ( tpy == 2 ? x : (mid = tpy == 1 ? 0.10 : 0.15; s = 1/mid - 1; bb = s*s; (pow(bb, x) - 1) / (bb - 1)); );
function set_values(sp) local(PP, v1, v2, t, b, mdl, mv, pl, mid, top, bass, ch1, low) (
  PP = sp + O_PAR; v1 = PP[0]; v2 = PP[1]; t = PP[2]; b = PP[3]; mdl = PP[4]; mv = PP[5]; pl = PP[6]; mid = PP[7]; top = PP[8]; bass = PP[9]; ch1 = PP[20]; low = PP[21];
  RV[0] = low ? 1000000000000 : r1;
  RV[1] = low ? r1 : 1000000000000;
  RV[2] = low ? 0.001 : 1000000000000;
  RV[3] = rp_of(0.00062);
  RV[4] = 2700;
  RV[5] = 100000;
  RV[6] = r5;
  RV[7] = ch1 ? 1000000000000 : (ronvt + r6);
  RV[8] = vr101*(1-v1);
  RV[9] = vr101*v1;
  RV[10] = rp_of(0.00069);
  RV[11] = 2700;
  RV[12] = 100000;
  RV[13] = vr102*(1-v2);
  RV[14] = vr102*v2;
  RV[15] = 68000;
  RV[16] = rp_of(0.00031);
  RV[17] = 10000;
  RV[18] = 100000;
  RV[19] = 470000;
  RV[20] = 470000;
  RV[21] = rp_of(0.00110);
  RV[22] = 820;
  RV[23] = 100000;
  RV[24] = rp_of(0.0015);
  RV[25] = 100000;
  RV[26] = blendR(0.001, 10000000, mid, 1/(2*$pi*1000*c8));
  RV[27] = r18;
  RV[28] = vr105*(1-t);
  RV[29] = vr105*t;
  RV[30] = vr106*b;
  RV[31] = vr107*(1-mdl);
  RV[32] = vr107*mdl;
  RV[33] = 1000000;
  RV[34] = 1000000;
  RV[35] = 3300000;
  RV[36] = rp_of(0.00118);
  RV[37] = 820;
  RV[38] = 100000;
  RV[39] = 68000;
  RV[40] = 33000;
  RV[41] = blendR(1000000000000, rts, bass, 33000);
  RV[42] = vr104*(1-mv);
  RV[43] = vr104*mv;
  RV[44] = 22000;
  RV[45] = blendR(1000000000000, rts, bass, 22000);
  RV[46] = blendR(22000, 1000000000, top, 22000);
  RV[47] = vr103*(1-pl);
  RV[48] = max(vr103*pl, 0.001);
  RV[49] = blendR(ronvt, 1000000000000, ch1, vr103);
  RV[50] = 1000000;
  CV[0] = cgk;
  CV[1] = cga;
  CV[2] = 0.000047;
  CV[3] = c2;
  CV[4] = cgk;
  CV[5] = cga;
  CV[6] = c3;
  CV[7] = low ? 0.000000000000000001 : ck;
  CV[8] = low ? ck : 0.000000000000000001;
  CV[9] = cgk;
  CV[10] = cga;
  CV[11] = c4;
  CV[12] = c5;
  CV[13] = cgk;
  CV[14] = cga;
  CV[15] = cgk;
  CV[16] = cga;
  CV[17] = c6;
  CV[18] = c7;
  CV[19] = c8;
  CV[20] = c11;
  CV[21] = c10;
  CV[22] = c9;
  CV[23] = c12;
  CV[24] = cgk;
  CV[25] = cga;
  CV[26] = c13;
  CV[27] = c14;
  CV[28] = c15;
  CV[29] = c16;
  CV[30] = c106;
  TGM[0] = mu / rp_of(0.00062);
  TGM[1] = mu / rp_of(0.00069);
  TGM[2] = mu / rp_of(0.00031);
  TGM[3] = mu / rp_of(0.00110);
  TGM[4] = mu / rp_of(0.0015);
  TGM[5] = mu / rp_of(0.00118);
);
function build(sp) local(i, j, r, c, a, b, g, pv, best, mm, d, f, q, tt, s2, x, K, kk, cc, G2) (
  set_values(sp);
  memset(AM, 0, M*M);
  i = 0; loop(NR, a = EA[i]; b = EB[i]; g = 1 / max(RV[i], 0.001);
    a >= 0 ? (AM[a*M+a] += g); b >= 0 ? (AM[b*M+b] += g); (a >= 0 && b >= 0) ? (AM[a*M+b] -= g; AM[b*M+a] -= g); i += 1);
  i = 0; loop(NC, a = CA[i]; b = CB[i]; g = 2 * CV[i] * srate;
    a >= 0 ? (AM[a*M+a] += g); b >= 0 ? (AM[b*M+b] += g); (a >= 0 && b >= 0) ? (AM[a*M+b] -= g; AM[b*M+a] -= g); i += 1);
  i = 0; loop(NT, g = TG[i]; pv = TP[i]; c = TK[i]; mm = TGM[i];
    pv >= 0 ? (AM[pv*M+g] += mm; c >= 0 ? (AM[pv*M+c] -= mm);); c >= 0 ? (AM[c*M+g] -= mm; AM[c*M+c] += mm); i += 1);
  AM[SRC*M+NN] = 1; AM[NN*M+SRC] = 1;
  c = 0; loop(M,
    pv = c; best = -1; r = c; loop(M - c, mm = abs(AM[r*M+c]); mm > best ? (best = mm; pv = r;); r += 1);
    PIV[c] = pv; pv != c ? (q = 0; loop(M, tt = AM[c*M+q]; AM[c*M+q] = AM[pv*M+q]; AM[pv*M+q] = tt; q += 1););
    d = AM[c*M+c]; r = c + 1;
    loop(M - c - 1, f = AM[r*M+c] / d; f !== 0 ? (AM[r*M+c] = f; q = c + 1; loop(M - c - 1, AM[r*M+q] -= f * AM[c*M+q]; q += 1);); r += 1);
    c += 1);
  K = sp + O_KMAT; kk = sp + O_KVEC; cc = sp + O_CROW; G2 = sp + O_GTWO;
  j = 0; loop(NC + 1,
    memset(RHS, 0, M);
    j < NC ? (a = CA[j]; b = CB[j]; a >= 0 ? (RHS[a] += 1); b >= 0 ? (RHS[b] -= 1);) : (RHS[NN] = 1);
    c = 0; loop(M, pv = PIV[c]; pv != c ? (tt = RHS[c]; RHS[c] = RHS[pv]; RHS[pv] = tt;); c += 1);
    r = 1; loop(M - 1, s2 = RHS[r]; q = 0; loop(r, s2 -= AM[r*M+q] * RHS[q]; q += 1); RHS[r] = s2; r += 1);
    r = M - 1; loop(M, s2 = RHS[r]; q = r + 1; loop(M - r - 1, s2 -= AM[r*M+q] * RHS[q]; q += 1); RHS[r] = s2 / AM[r*M+r]; r -= 1);
    i = 0; loop(NC, a = CA[i]; b = CB[i]; x = (a >= 0 ? RHS[a] : 0) - (b >= 0 ? RHS[b] : 0);
      j < NC ? (K[i*NC+j] = x) : (kk[i] = x); i += 1);
    j < NC ? (cc[j] = RHS[OUT]) : (sp[O_DSC] = RHS[OUT]);
    j += 1);
  i = 0; loop(NC, G2[i] = 4 * CV[i] * srate; i += 1);
);
