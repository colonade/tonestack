function nl_vals0(ni) local(q, v1, v2, t, b, mdl, mv, pl, mid, top, bass, ch1, low, rvp, cvp) (
  q = ni + NO_par; v1 = q[0]; v2 = q[1]; t = q[2]; b = q[3]; mdl = q[4]; mv = q[5]; pl = q[6]; mid = q[7]; top = q[8]; bass = q[9]; ch1 = q[20]; low = q[21];
  rvp = NLMETA[12]; cvp = NLMETA[15];
  rvp[0] = r1;
  cvp[0] = 0.000000000081;
);
function nl_vals1(ni) local(q, v1, v2, t, b, mdl, mv, pl, mid, top, bass, ch1, low, rvp, cvp) (
  q = ni + NO_par; v1 = q[0]; v2 = q[1]; t = q[2]; b = q[3]; mdl = q[4]; mv = q[5]; pl = q[6]; mid = q[7]; top = q[8]; bass = q[9]; ch1 = q[20]; low = q[21];
  rvp = NLMETA[44]; cvp = NLMETA[47];
  rvp[0] = 100000;
  rvp[1] = 2700;
  rvp[2] = r5;
  rvp[3] = (ch1 <= 0 ? ronvt + r6 : ch1 >= 1 ? 1000000000000 : blendR(ronvt + r6, 1000000000000, 1 - ch1, 50000));
  rvp[4] = vr101*(1-v1);
  rvp[5] = vr101*v1;
  cvp[0] = 0.000047;
  cvp[1] = c2;
  cvp[2] = 0.000000000097;
);
function nl_vals2(ni) local(q, v1, v2, t, b, mdl, mv, pl, mid, top, bass, ch1, low, rvp, cvp) (
  q = ni + NO_par; v1 = q[0]; v2 = q[1]; t = q[2]; b = q[3]; mdl = q[4]; mv = q[5]; pl = q[6]; mid = q[7]; top = q[8]; bass = q[9]; ch1 = q[20]; low = q[21];
  rvp = NLMETA[76]; cvp = NLMETA[79];
  rvp[0] = 100000;
  rvp[1] = 2700;
  rvp[2] = (low ? 0.001 : 1000000000000);
  rvp[3] = vr102*(1-v2);
  rvp[4] = vr102*v2;
  rvp[5] = 68000;
  cvp[0] = c3;
  cvp[1] = (low ? 0.000000000000000001 : ck);
  cvp[2] = (low ? ck : 0.000000000000000001);
  cvp[3] = 0.000000000016;
);
function nl_vals3(ni) local(q, v1, v2, t, b, mdl, mv, pl, mid, top, bass, ch1, low, rvp, cvp) (
  q = ni + NO_par; v1 = q[0]; v2 = q[1]; t = q[2]; b = q[3]; mdl = q[4]; mv = q[5]; pl = q[6]; mid = q[7]; top = q[8]; bass = q[9]; ch1 = q[20]; low = q[21];
  rvp = NLMETA[108]; cvp = NLMETA[111];
  rvp[0] = 100000;
  rvp[1] = 10000;
  rvp[2] = 470000;
  rvp[3] = 470000;
  cvp[0] = c4;
  cvp[1] = c5;
  cvp[2] = 0.000000000072;
);
function nl_vals4(ni) local(q, v1, v2, t, b, mdl, mv, pl, mid, top, bass, ch1, low, rvp, cvp) (
  q = ni + NO_par; v1 = q[0]; v2 = q[1]; t = q[2]; b = q[3]; mdl = q[4]; mv = q[5]; pl = q[6]; mid = q[7]; top = q[8]; bass = q[9]; ch1 = q[20]; low = q[21];
  rvp = NLMETA[140]; cvp = NLMETA[143];
  rvp[0] = 100000;
  rvp[1] = 820;
  rvp[2] = 100000;
  rvp[3] = (mid >= 1 ? 0.001 : mid <= 0 ? 10000000 : blendR(0.001, 10000000, mid, 1/(2*$pi*1000*c8)));
  rvp[4] = r18;
  rvp[5] = vr105*(1-t);
  rvp[6] = vr105*t;
  rvp[7] = vr106*b;
  rvp[8] = vr107*(1-mdl);
  rvp[9] = vr107*mdl;
  rvp[10] = 1000000;
  rvp[11] = 1000000;
  rvp[12] = 3300000;
  rvp[13] = 100000;
  rvp[14] = 820;
  rvp[15] = 68000;
  rvp[16] = 33000;
  rvp[17] = (bass <= 0 ? rts : bass >= 1 ? 1000000000000 : blendR(1000000000000, rts, bass, 33000));
  rvp[18] = vr104*(1-mv);
  rvp[19] = vr104*mv;
  rvp[20] = 22000;
  rvp[21] = (bass <= 0 ? rts : bass >= 1 ? 1000000000000 : blendR(1000000000000, rts, bass, 22000));
  rvp[22] = (top >= 1 ? 22000 : top <= 0 ? 1000000000 : blendR(22000, 1000000000, top, 22000));
  rvp[23] = vr103*(1-pl);
  rvp[24] = max(vr103*pl, 0.001);
  rvp[25] = (ch1 >= 1 ? ronvt : ch1 <= 0 ? 1000000000000 : blendR(ronvt, 1000000000000, ch1, vr103));
  rvp[26] = 1000000;
  cvp[0] = cga;
  cvp[1] = cgk;
  cvp[2] = c6;
  cvp[3] = c7;
  cvp[4] = c8;
  cvp[5] = c11;
  cvp[6] = c10;
  cvp[7] = c9;
  cvp[8] = c12;
  cvp[9] = c13;
  cvp[10] = cgk;
  cvp[11] = cga;
  cvp[12] = c14;
  cvp[13] = c15;
  cvp[14] = c16;
  cvp[15] = c106;
);
function nl_vals(sk, ni) ( sk === 0 ? nl_vals0(ni) : sk === 1 ? nl_vals1(ni) : sk === 2 ? nl_vals2(ni) : sk === 3 ? nl_vals3(ni) : nl_vals4(ni); );
// Übersetzen eines Abschnitts (Knotenanalyse, LU-Zerlegung, Spalten für Kondensatoren, Quellen, Ports)
function nl_compile(sk, dc, fsx, dMc, dMp, dG2, dFull) local(mt, n, ns, ncn, np, npr, ncol, mm, ra, rb, rvp, cap, cbp, cvp, sn, pf, pt, pr, nrn, ncap, i, j, a, b, g, c, r, pvn, best, mx, d, f, q, tt, s2, x) (
  mt = NLMETA + sk*32; n = mt[MF_N]; ns = mt[MF_NS]; ncn = mt[MF_NC]; np = mt[MF_NP]; npr = mt[MF_NPR]; nrn = mt[MF_NR];
  ra = mt[MF_RA]; rb = mt[MF_RB]; rvp = mt[MF_RV]; cap = mt[MF_CA]; cbp = mt[MF_CB]; cvp = mt[MF_CV]; sn = mt[MF_SN]; pf = mt[MF_PF]; pt = mt[MF_PT]; pr = mt[MF_PR];
  mm = n + ns; ncap = dc ? 0 : ncn; ncol = ncap + ns + np;
  memset(AMN, 0, mm*mm);
  i = 0; loop(nrn, a = ra[i]; b = rb[i]; g = 1 / max(rvp[i], 0.001);
    a >= 0 ? (AMN[a*mm+a] += g); b >= 0 ? (AMN[b*mm+b] += g); (a >= 0 && b >= 0) ? (AMN[a*mm+b] -= g; AMN[b*mm+a] -= g;); i += 1);
  dc ? 0 : (i = 0; loop(ncn, a = cap[i]; b = cbp[i]; g = 2 * cvp[i] * fsx;
    a >= 0 ? (AMN[a*mm+a] += g); b >= 0 ? (AMN[b*mm+b] += g); (a >= 0 && b >= 0) ? (AMN[a*mm+b] -= g; AMN[b*mm+a] -= g;); i += 1););
  i = 0; loop(ns, a = sn[i]; AMN[a*mm + n + i] = 1; AMN[(n + i)*mm + a] = 1; i += 1);
  c = 0; loop(mm,
    pvn = c; best = -1; r = c; loop(mm - c, mx = abs(AMN[r*mm+c]); mx > best ? (best = mx; pvn = r;); r += 1);
    PIVN[c] = pvn; pvn !== c ? (q = 0; loop(mm, tt = AMN[c*mm+q]; AMN[c*mm+q] = AMN[pvn*mm+q]; AMN[pvn*mm+q] = tt; q += 1););
    d = AMN[c*mm+c]; r = c + 1;
    loop(mm - c - 1, f = AMN[r*mm+c] / d; f !== 0 ? (AMN[r*mm+c] = f; q = c + 1; loop(mm - c - 1, AMN[r*mm+q] -= f * AMN[c*mm+q]; q += 1);); r += 1);
    c += 1);
  j = 0; loop(ncol,
    memset(RHSN, 0, mm);
    j < ncap ? (a = cap[j]; b = cbp[j]; a >= 0 ? (RHSN[a] += 1); b >= 0 ? (RHSN[b] -= 1);) :
      j < ncap + ns ? (RHSN[n + j - ncap] = 1;) : (a = pf[j - ncap - ns]; b = pt[j - ncap - ns]; a >= 0 ? (RHSN[a] -= 1); b >= 0 ? (RHSN[b] += 1););
    c = 0; loop(mm, pvn = PIVN[c]; pvn !== c ? (tt = RHSN[c]; RHSN[c] = RHSN[pvn]; RHSN[pvn] = tt;); c += 1);
    r = 1; loop(mm - 1, s2 = RHSN[r]; q = 0; loop(r, s2 -= AMN[r*mm+q] * RHSN[q]; q += 1); RHSN[r] = s2; r += 1);
    r = mm - 1; loop(mm, s2 = RHSN[r]; q = r + 1; loop(mm - r - 1, s2 -= AMN[r*mm+q] * RHSN[q]; q += 1); RHSN[r] = s2 / AMN[r*mm+r]; r -= 1);
    i = 0; loop(ncap, a = cap[i]; b = cbp[i]; x = (a >= 0 ? RHSN[a] : 0) - (b >= 0 ? RHSN[b] : 0); dMc[i*ncol+j] = x; i += 1);
    i = 0; loop(npr, a = pr[i]; dMp[i*ncol+j] = a >= 0 ? RHSN[a] : 0; i += 1);
    dc ? (q = 0; loop(n, dFull[j*n+q] = RHSN[q]; q += 1););
    j += 1);
  dc ? 0 : (i = 0; loop(ncn, dG2[i] = 4 * cvp[i] * fsx; i += 1););
);
function nl_prep(sk, dMp, dvq, dc) local(mt, ncn, ns, npr, nu, ncol, r, u) (
  mt = NLMETA + sk*32; ncn = dc ? 0 : mt[MF_NC]; ns = mt[MF_NS]; npr = mt[MF_NPR]; nu = mt[MF_NU]; ncol = ncn + ns + mt[MF_NP];
  r = 0; loop(npr, u = 0; loop(nu, dvq[r*nu+u] = dMp[r*ncol + ncn + ns + u]; u += 1); r += 1);
);
// Röhrenkennlinie (Koren 12AX7), exakt und als Tabelle
function tube_exact(vgk, vpk) local(s, q, sp, sig, eq, e1, pw, ii, di) (
  vpk <= 0.000001 ? (tb0 = tb1 = tb2 = 0;) : (
    s = sqrt(300 + vpk*vpk); q = 600 * (1/100 + vgk / s);
    q > 35 ? (sp = q; sig = 1;) : (eq = exp(q); sp = log(1 + eq); sig = eq / (1 + eq););
    e1 = vpk / 600 * sp;
    e1 <= 0 ? (tb0 = tb1 = tb2 = 0;) : (
      pw = exp(0.4 * log(e1)); ii = 2 * pw * e1 / 1060; di = 2 * 1.4 * pw / 1060;
      tb0 = ii; tb1 = di * vpk * sig / s; tb2 = di * (sp / 600 - sig * vgk * vpk * vpk / (s*s*s));
    );
  );
);
function make_tab() local(i, j) (
  i = 0; loop(1501, j = 0; loop(321, tube_exact(-12 + i * 0.01, j); TABB[i*321+j] = tb0; j += 1); i += 1);
  tab_ok = 20260929;
);
function tube(vgk, vpk) local(x, y, i, j, fx, fy, o, a, b, c, d, ab, cd) (
  x = (vgk + 12) / 0.01; y = vpk;
  (x > 1500 - 0.000001 || y > 320 - 0.000001) ? tube_exact(vgk, vpk) : (
    x < 0 ? (x = 0;); y < 0 ? (y = 0;);
    i = floor(x); j = floor(y); fx = x - i; fy = y - j; o = i*321 + j;
    a = TABB[o]; b = TABB[o+1]; c = TABB[o+321]; d = TABB[o+322];
    ab = a + (b - a) * fy; cd = c + (d - c) * fy;
    tb0 = ab + (cd - ab) * fx;
    tb1 = (vgk + 12 < 0) ? 0 : (cd - ab) / 0.01;
    tb2 = (vpk < 0) ? 0 : ((b - a) + ((d - c) - (b - a)) * fx);
  );
);
function grid(v) local(x, e) (
  x = v / 0.02; x > 35 ? (gb0 = v / 2000; gb1 = 1 / 2000;) : (e = exp(x); gb0 = 0.02 * log(1 + e) / 2000; gb1 = e / (1 + e) / 2000;);
);
