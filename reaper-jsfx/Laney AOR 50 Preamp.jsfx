desc:Laney AOR 50 Vorverstärker (nach Schaltplan DRG 1054, mit Röhrenverzerrung)
//tags: amp preamp bass tube laney
//author: erzeugt aus dem Laney-AOR-50-Simulator
// Modell des kompletten Vorverstärkers nach Schaltplan DRG 1054 (2/4/85): V101A bis V103B, Klangregler,
// Mid/Top/Bass Boost, Master, Preamp 1 Level, Kanalumschaltung über VT1/VT2, Eingänge HIGH/LOW.
// Rechnung: Knotenanalyse im Zeitbereich (Trapezregel), identisch mit dem Rechenkern des Simulators.
// Röhrenverzerrung wahlweise: Koren-Modell 12AX7 mit Gitterstrom, fünf Abschnitte, Newton-Verfahren (Schätzung, nicht am Gerät gemessen).
// Endstufe, Ausgangsübertrager und Lautsprecher sind nicht enthalten.
// Pegel linear: Grundstellung des jeweiligen Kanals und Eingangs bei 1 kHz = 0 dB; Verzerrung: Ausgang der Vorstufe / 20 V. Mono.
// Annahmen: ECC83 (mu 100, rp 62,5 kOhm bei 1,2 mA), Optokoppler leitend 200 Ohm, JFET leitend 250 Ohm.

slider1:0<0,1,1{HIGH (~1 mV),LOW (~30 mV)}>Eingangsbuchse
slider2:0<0,1,1{Preamp 1 (High Gain),Preamp 2 (Grundzustand)}>Kanal
slider3:5<0,10,0.1>Preamp 1 Volume
slider4:5<0,10,0.1>Preamp 2 Volume
slider5:5<0,10,0.1>Preamp 1 Level (nur Preamp 1)
slider6:5<0,10,0.1>Treble
slider7:5<0,10,0.1>Middle
slider8:5<0,10,0.1>Bass
slider9:5<0,10,0.1>Master Volume
slider10:0<0,1,1{Aus,An}>Mid Boost (S105)
slider11:0<0,1,1{Aus,An}>Top Boost (S104)
slider12:0<0,1,1{Aus,An}>Bass Boost (Zugschalter)
slider13:0<0,1,1{Original,Umbau C2 C3 C14}>Bass-Umbau
slider14:0<0,1,1{Aus,An}>Effektweg + Endstufeneingang
slider15:0<0,2,1{Log 15 %,Log 10 %,Linear}>Kennlinie Middle-Poti
slider16:0<-36,24,0.1>Ausgangspegel (dB)
slider17:1<0,1,1{Aus (lineares Modell),An (Schätzung)}>Röhrenverzerrung
slider18:100<1,1000,1>Instrumentenpegel bei 0 dBFS (mV Spitze)
slider19:2<0,3,1{2-fach,1-fach,4-fach,8-fach}>Überabtastung (Verzerrung)

in_pin:links
in_pin:rechts
out_pin:links
out_pin:rechts

